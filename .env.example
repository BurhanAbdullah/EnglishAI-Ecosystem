# EnglishAI Ecosystem production configuration
# Never commit real values. Configure these in Render/environment secrets.

# PostgreSQL connection string for Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Auth/session provider configuration
AUTH_SECRET=replace-with-a-long-random-secret
SITE_URL=https://englishai-ecosystem-live.onrender.com

# OAuth provider (Google or GitHub, depending on the selected auth implementation)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_CALLBACK_URL=https://englishai-ecosystem-live.onrender.com/api/auth/callback

# MCP gateway
MCP_GATEWAY_URL=https://englishai-mcp-gateway.onrender.com/mcp

# Email delivery for password reset and application notifications
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=

# Optional operational controls
ADMIN_BOOTSTRAP_EMAIL=
