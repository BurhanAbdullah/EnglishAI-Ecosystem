{
  "name": "englishai-ecosystem",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local-first, MCP-enabled software architecture for AI-assisted English language learning and teaching.",
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:mcp": "vitest run tests/mcp",
    "validate:site": "node scripts/validate-site.mjs",
    "dev:content": "tsx mcp-servers/english-content/src/index.ts",
    "dev:grammar": "tsx mcp-servers/grammar/src/index.ts",
    "dev:vocabulary": "tsx mcp-servers/vocabulary/src/index.ts",
    "dev:reading": "tsx mcp-servers/reading/src/index.ts",
    "dev:writing": "tsx mcp-servers/writing/src/index.ts",
    "dev:assessment": "tsx mcp-servers/assessment/src/index.ts",
    "dev:citation": "tsx mcp-servers/citation/src/index.ts",
    "start:mcp-gateway": "tsx mcp-gateway/src/index.ts",
    "verify:mcp-gateway": "tsx scripts/verify-mcp-gateway.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "latest",
    "@modelcontextprotocol/client": "latest",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
